BUNKFY_PUBLIC_PORT=8080
BUNKFY_ADMIN_PORT=5195
BUNKFY_PUBLIC_URL=http://localhost:8080
BUNKFY_ALLOWED_HOSTS=localhost;127.0.0.1
BUNKFY_COMPOSE_PROJECT_NAME=bunkfy-preview
BUNKFY_VOLUME_PREFIX=bunkfy-preview
BUNKFY_RELEASE_ID=preview-local

# Use long, randomly generated values. Keep PostgreSQL/NATS values URL and connection-string safe.
BUNKFY_POSTGRES_PASSWORD=replace-with-random-postgres-password
BUNKFY_REDIS_PASSWORD=replace-with-random-redis-password
BUNKFY_NATS_USER=bunkfy
BUNKFY_NATS_PASSWORD=replace-with-random-nats-password
BUNKFY_MINIO_ROOT_USER=bunkfy-minio
BUNKFY_MINIO_ROOT_PASSWORD=replace-with-random-minio-password
BUNKFY_JWT_SIGNING_KEY=replace-with-at-least-32-random-characters
BUNKFY_REFRESH_TOKEN_PEPPER=replace-with-a-separate-random-secret
BUNKFY_DATA_RIGHTS_PSEUDONYMISATION_KEY=replace-with-base64-pseudonymisation-key
BUNKFY_DATA_RIGHTS_REPLAY_ENVELOPE_KEY=replace-with-base64-replay-envelope-key
BUNKFY_DATA_RIGHTS_LEDGER_INTEGRITY_KEY=replace-with-base64-ledger-integrity-key
BUNKFY_DATA_RIGHTS_EXPORT_ARTIFACT_KEY=replace-with-base64-export-artifact-key

# Optional browser identity providers. Keep disabled until callback URLs and credentials are registered.
BUNKFY_GOOGLE_OIDC_ENABLED=false
BUNKFY_GOOGLE_OIDC_CLIENT_ID=
BUNKFY_GOOGLE_OIDC_CLIENT_SECRET=
BUNKFY_MICROSOFT_OIDC_ENABLED=false
BUNKFY_MICROSOFT_OIDC_CLIENT_ID=
BUNKFY_MICROSOFT_OIDC_CLIENT_SECRET=

# Keep false until a real IEmailSender adapter and sender configuration are mounted.
BUNKFY_EMAIL_VERIFICATION_ENABLED=false
BUNKFY_ALLOW_GENERATED_ADMIN_PASSWORDS=false
